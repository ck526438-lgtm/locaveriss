<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <ImageView
            android:id="@+id/backBtn"
            style="@style/RoundIcon"
            android:contentDescription="Retour"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/initiale"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_circle_ink"
            android:fontFamily="@font/outfit_bold"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/nom"
            style="@style/Title"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/sousTitre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/etat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_grey"
            android:fontFamily="@font/outfit_semibold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/whatsappBtn"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/green_dark"
                android:text="WhatsApp" />

            <Button
                android:id="@+id/callBtn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="Appeler" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="Sa demande" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_field"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/annonce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_semibold"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_dim"
                android:textIsSelectable="true"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="Profil locataire" />

        <LinearLayout
            android:id="@+id/infos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/presentation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_field"
            android:lineSpacingExtra="3dp"
            android:padding="16dp"
            android:textColor="@color/text"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/red"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/accepterBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:text="Accepter la demande" />

        <Button
            android:id="@+id/refuserBtn"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Refuser la demande"
            android:textColor="@color/red" />
    </LinearLayout>
</ScrollView>
