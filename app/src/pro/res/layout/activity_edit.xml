<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nouvelle annonce"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView style="@style/Label" android:text="Titre de l'annonce" />
        <EditText
            android:id="@+id/titreInput"
            style="@style/Field"
            android:hint="Ex. Studio moderne avec cuisine équipée"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="90" />

        <TextView style="@style/Label" android:text="Type de bien" />
        <Spinner
            android:id="@+id/typeSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp" />

        <TextView style="@style/Label" android:text="Ville" />
        <EditText
            android:id="@+id/villeInput"
            style="@style/Field"
            android:hint="Ex. Abidjan"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLength="60" />

        <TextView style="@style/Label" android:text="Commune / quartier" />
        <EditText
            android:id="@+id/quartierInput"
            style="@style/Field"
            android:hint="Ex. Cocody Angré 8e tranche"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLength="80" />

        <TextView style="@style/Label" android:text="Loyer mensuel (FCFA)" />
        <EditText
            android:id="@+id/loyerInput"
            style="@style/Field"
            android:hint="Ex. 80000"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="9" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/Label" android:text="Caution (mois)" />
                <EditText
                    android:id="@+id/cautionInput"
                    style="@style/Field"
                    android:hint="2"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/Label" android:text="Avance (mois)" />
                <EditText
                    android:id="@+id/avanceInput"
                    style="@style/Field"
                    android:hint="2"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/Label" android:text="Pièces" />
                <EditText
                    android:id="@+id/piecesInput"
                    style="@style/Field"
                    android:hint="1"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="2" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/Label" android:text="Téléphone / WhatsApp à contacter" />
        <EditText
            android:id="@+id/telInput"
            style="@style/Field"
            android:hint="Ex. 0701020304"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:maxLength="20" />

        <TextView style="@style/Label" android:text="Description" />
        <EditText
            android:id="@+id/descInput"
            style="@style/Field"
            android:gravity="top"
            android:hint="Eau, électricité, étage, parking, proximité…"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="1500"
            android:minLines="4" />

        <TextView
            android:id="@+id/photoLabel"
            style="@style/Label"
            android:text="Photos (0/5) — touche une photo pour la retirer" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/photos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/addPhotoBtn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:text="Ajouter des photos" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/red"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:text="Envoyer pour vérification"
            android:textSize="16sp" />

        <Button
            android:id="@+id/dispoBtn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="4dp"
            android:text="Marquer comme loué"
            android:visibility="gone" />

        <Button
            android:id="@+id/deleteBtn"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Supprimer l'annonce"
            android:textColor="@color/red"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
