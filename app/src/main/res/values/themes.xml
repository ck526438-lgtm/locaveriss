<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Locaveriss" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryVariant">@color/navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
</resources>
