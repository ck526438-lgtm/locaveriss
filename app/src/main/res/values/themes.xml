<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Locaveriss" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorPrimaryVariant">@color/ink</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="fontFamily">@font/outfit</item>
        <item name="textAppearanceButton">@style/TextAppearance.Locaveriss.Button</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Locaveriss.Pill</item>
        <item name="materialButtonStyle">@style/Widget.Locaveriss.Button</item>
    </style>

    <style name="ShapeAppearance.Locaveriss.Pill" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance.Locaveriss.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="fontFamily">@font/outfit_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Locaveriss.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:insetTop">3dp</item>
        <item name="android:insetBottom">3dp</item>
    </style>

    <!-- Champ de saisie : fond gris arrondi, sans trait -->
    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <!-- Grand titre d'écran -->
    <style name="Title">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/outfit_bold</item>
        <item name="android:lineSpacingMultiplier">0.95</item>
    </style>

    <style name="Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/outfit_bold</item>
        <item name="android:layout_marginTop">24dp</item>
    </style>

    <!-- Pastille d'information (type, pièces, caution…) -->
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
    </style>

    <!-- Onglet de tri ou de filtre : gris, noir quand il est choisi -->
    <style name="Tab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
    </style>

    <!-- Bouton rond blanc ou gris (retour, favori, filtres) -->
    <style name="RoundIcon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">13dp</item>
        <item name="android:background">@drawable/bg_circle_grey</item>
    </style>

    <style name="NavItem">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">13dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_nav_item</item>
    </style>
</resources>
